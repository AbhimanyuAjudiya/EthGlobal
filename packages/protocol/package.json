{
  "name": "@ethglobal/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Wire and ledger schemas (zod), the x402 header codec and 402 client loop, money/data units, ids, error codes, event names, httpJson, EIP-712 message definitions and the PIN format. Leaf package, browser-safe.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./typed-data": {
      "types": "./dist/typed-data.d.ts",
      "import": "./dist/typed-data.js"
    },
    "./pin": {
      "types": "./dist/pin.d.ts",
      "import": "./dist/pin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@x402/core": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  }
}
