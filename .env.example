# Copy to `.env` at the repo root. Every value here is read by services/api, scripts/*.sh and
# apps/web (next.config.ts loads the root .env). Keep real keys out of git: `.env` is ignored.

# ── Mode ────────────────────────────────────────────────────────────────────────────────────
# local = Anvil (chain 31337) + in-memory mock adapters, zero network calls (what CI runs).
# live  = real RPCs and sponsor APIs; requires the URLs and keys below.
MODE=local

# ── Service ─────────────────────────────────────────────────────────────────────────────────
PORT=8787
# listen address (RT-P-01): loopback by default in every mode; MODE=local refuses anything else.
# A live VPS without a local reverse proxy sets HOST=0.0.0.0 explicitly.
HOST=127.0.0.1
LOG_LEVEL=info
# Chain id the API serves in live mode, and the RPC it reads from (pick one of the URLs below).
CHAIN=31337
RPC_URL=

# ── RPC URLs, one per chain id (variable names match packages/contracts/deploy/chains.json) ──
# 31337 Anvil (scripts/dev-chain.sh)
ANVIL_RPC_URL=http://127.0.0.1:8545
# 1301 Unichain Sepolia
UNICHAIN_SEPOLIA_RPC_URL=
# 5042002 Arc Testnet (gas in USDC)
ARC_TESTNET_RPC_URL=
# 16602 0G Galileo
ZG_GALILEO_RPC_URL=
# 296 Hedera Testnet (JSON-RPC relay)
HEDERA_TESTNET_RPC_URL=
# 4801 World Chain Sepolia
WORLDCHAIN_SEPOLIA_RPC_URL=
# 1874 Whitechain Sepolia (gas in WBT)
WHITECHAIN_SEPOLIA_RPC_URL=
# 84532 Base Sepolia
BASE_SEPOLIA_RPC_URL=
# 295 Hedera Mainnet (JSON-RPC relay)
HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
# 8453 Base
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# ── Deployer ────────────────────────────────────────────────────────────────────────────────
# Leave empty for MODE=local: scripts/dev-chain.sh falls back to Anvil's public account #0 key.
DEPLOYER_PRIVATE_KEY=

# ── World ID (IDKit) ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=recharge-welcome

# ── Arkiv ───────────────────────────────────────────────────────────────────────────────────
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_PRIVATE_KEY=

# ── Hedera (x402 / Agent Kit) ───────────────────────────────────────────────────────────────
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# ── 0G (compute / storage) ──────────────────────────────────────────────────────────────────
ZG_PRIVATE_KEY=
ZG_COMPUTE_PROVIDER=

# ── Recharge (docs/INTERFACES.md §11, incl. amendments A-20…A-31) ─────────────────────────────
# Values below are local defaults or public endpoints; never put a real key in this file.

# Octroi / keys (never NEXT_PUBLIC_; on-site generated in live; local uses Anvil roles)
# 32 bytes hex; HMAC root (quota, audit, pin, challenge MAC). ≥ 32 bytes enforced (T-29)
OCTROI_SECRET=
# 32 bytes hex; seals ICCIDs at rest
SERVER_SEAL_KEY=
# DataDrop.claim; local: Anvil #2
ATTESTOR_PRIVATE_KEY=
# self-run facilitator; local: Anvil #6
RELAYER_PRIVATE_KEY=
# x402 payTo on EVM networks and DataDrop payout; local: Anvil #1
PAYOUT_ADDRESS=
# x402 payTo on hedera:testnet
PAYOUT_HEDERA_ACCOUNT=
# a SEPARATE refund wallet (not PAYOUT_ADDRESS), funded ≤ TREASURY_MAX_USD6_PER_DAY, used ONLY for gift reclaims (EvmTreasury); local: Anvil #8 (`anvilRoles.treasury`, A-31)
TREASURY_PRIVATE_KEY=
# separate Hedera refund account (ECDSA, associated with 0.0.429274), same purpose
TREASURY_HEDERA_ACCOUNT=
TREASURY_HEDERA_PRIVATE_KEY=
# $50/day of reclaims; the API refuses beyond it (503 treasury cap, logged)
TREASURY_MAX_USD6_PER_DAY=50000000
# deducted from a reclaim to cover the network fee (testnet: 0)
GIFT_RECLAIM_FEE_USD6=0
# optional override of deploy/addresses.<slug>.json
DATADROP_ADDRESS=
# mock | self | remote (local default: self when ANVIL_RPC_URL answers, else mock)
X402_FACILITATOR=self
# host must be in the allow-list (T-42): x402.org, api.testnet.blocky402.com, testnet.facilitator.launa.dev, localhost
X402_FACILITATOR_URL_EVM=https://x402.org/facilitator
# fallback https://api.testnet.blocky402.com (fee payer 0.0.7162784)
X402_FACILITATOR_URL_HEDERA=https://x402.org/facilitator
# comma list of accepts[] networks; must ⊂ TESTNET_NETWORKS unless SALES_ENABLED=true and LEGAL_MEMO_OK=true (T-52)
X402_NETWORKS=eip155:31337
# $0.40 per 100 MB
PRICE_USD6_PER_STEP=400000
VALIDITY_DAYS=7
TOPUPS_PER_ICCID_PER_DAY=20
SALES_ENABLED=false
LEGAL_MEMO_OK=false
TRUST_PROXY=0
# exact browser origins; MODE=live refuses localhost and defaults to none (RT-A-09)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# payers whose X-Agent-Uaid is recorded (T-77); local default Anvil #4; MODE=live defaults to none, refuses Anvil
AGENT_PAYERS=
# sealed durable API state (pending deliveries, T-24 intents; RT-A-11); required in MODE=live, on a persistent volume
STATE_FILE=
# protects /print/cards (T-64): >= 32 random bytes, e.g. `openssl rand -base64 32 | tr '+/' '-_' | tr -d =` (43 chars)
PRINT_TOKEN=

# Reseller
# mock | esimaccess | megaesim | inventory ; RESELLER_FALLBACK=inventory
RESELLER=mock
RESELLER_FALLBACK=inventory
# signing key defaults to the access code (A-27)
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SIGNING_KEY=
ESIMACCESS_WEBHOOK_TOKEN=
ESIMACCESS_BASE_URL=https://api.esimaccess.com/api/v1/open
ESIMACCESS_WEBHOOK_IPS=3.1.131.226,54.254.74.88,18.136.190.97,18.136.60.197,18.136.19.137

# MegaeSIM: no variables — fixture-only stub (A-28); RESELLER=megaesim is refused in live
# local webhook simulator
MOCK_RESELLER_WEBHOOK_SECRET=
INVENTORY_FILE=fixtures/inventory.enc
INVENTORY_SEAL_KEY=

# World (server side)
# signing key: Portal shows it once; server secret only (A-25)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=recharge-welcome
WORLD_ENVIRONMENT=production
WORLD_VERIFY_BASE_URL=https://developer.world.org

# World ID Agent Pass (docs/WORLD_AGENT_PASS.md): the OIDC device grant that arms an agent policy. OFF until the
# client id is set. Register "Recharge agent" at https://auth.world.org/portal with client_secret_post (the callback
# URL is a required placeholder; the device grant never uses it). MODE=local accepts WORLD_AGENT_PASS_CLIENT_ID=simulated
# (an in-process, labelled IdP; refused in live).
WORLD_AGENT_PASS_ISSUER=https://auth.world.org
WORLD_AGENT_PASS_CLIENT_ID=
# shown once by the portal (starts with worldidp_client_secret_); server secret, never NEXT_PUBLIC_, never logged
WORLD_AGENT_PASS_CLIENT_SECRET=
# private_key_jwt instead of the secret: the private RSA JWK as one JSON line (the portal gets only its public JWKS)
WORLD_AGENT_PASS_PRIVATE_KEY_JWK=
# auth_time may be at most this old when the ID token is validated (step-up freshness)
WORLD_AGENT_PASS_MAX_AGE_S=300
# an accepted pass arms the agent policy for this long (from auth_time)
WORLD_AGENT_PASS_VALID_S=86400
# accepted acr values (the essential claims request and the backend check); csv
WORLD_AGENT_PASS_ACR=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/selfie

# Arkiv — rabdi testnet; Kaolin (60138453025) is retired (A-23). tiramisu 7738577 is the configurable alternative if Arkiv judges ask for it.
ARKIV_CHAIN_ID=7794095
ARKIV_WS_URL=wss://rpc.rabdi.db-chain.testnet.arkiv.network
# hub.arkiv.network/access-keys; appended as the last RPC path segment (not a secret, never logged anyway)
ARKIV_ACCESS_KEY=
# gas: tGLM from hub.arkiv.network/faucet
ARKIV_BLOCK_TIME_MS=2000
ARKIV_EXPLORER=https://rabdi.explorer.arkiv.network

# Hedera / HCS
# ECDSA keys (PrivateKey.fromStringECDSA)
HCS_TOPIC_ID=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# optional pin; must equal the facilitator's /supported extra.feePayer (x402.org advertises 0.0.9185802) (A-20)
X402_HEDERA_FEE_PAYER=

# ENS
ENS_RPC_URL=
ENS_FALLBACK_RPC_URL=

# Swarm
SWARM_BEE_URL=
SWARM_POSTAGE_BATCH=

# Agent (see §8)
AGENT_API_URL=http://127.0.0.1:8787
AGENT_TICK_MS=5000
AGENT_WATCH_KEYS=
AGENT_OWNER=
AGENT_PAYTO_ALLOWLIST=
AGENT_MAX_USD6_PER_STEP=1000000
AGENT_EVM_PRIVATE_KEY=
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
AGENT_UAID=
AGENT_DRY_RUN=0
AGENT_ONCE=0
LLM_PROVIDER=none
# Agent additions (services/agent/README.md): the Arkiv writer every agent read trusts (T-79, required live; = the
# API's ARKIV_PRIVATE_KEY address), the EVM RPC for the EVM payer (local: Anvil), the state dir (git-ignored), and the
# optional phrasing model (both required with LLM_PROVIDER=anthropic)
AGENT_LEDGER_WRITER=
AGENT_EVM_RPC_URL=http://127.0.0.1:8545
AGENT_STATE_DIR=.agent
AGENT_LLM_MODEL=
ANTHROPIC_API_KEY=

# Web (public)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_MODE=local
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
NEXT_PUBLIC_EXPLORER_EVM=
NEXT_PUBLIC_EXPLORER_HEDERA=https://hashscan.io/testnet
NEXT_PUBLIC_ARKIV_EXPLORER=https://rabdi.explorer.arkiv.network
# apps/web: the public origin printed scratch cards encode in their QR (<origin>/card/<serial>); required outside
# MODE=local (local falls back to the request host, i.e. 127.0.0.1). Set it BEFORE `pnpm -r run build` (NEXT_PUBLIC_*
# can be inlined into the build) and export it for `pnpm print:cards`, which refuses --mint/--input without an https:// one
NEXT_PUBLIC_PUBLIC_ORIGIN=
# apps/web, server-only, MODE=local only: the demo wallet's source (the public Anvil test mnemonic) and the
# print route's token + one-time card file (scripts/print-cards.ts writes it); never NEXT_PUBLIC_
DEMO_WALLET_MNEMONIC=
PRINT_CARDS_FILE=
