{
  "name": "ethglobal-mumbai",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm monorepo: Next.js web app, Hono API, Foundry contracts, sponsor-SDK adapters, design tokens.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:chain": "bash scripts/dev-chain.sh",
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --filter '!@ethglobal/contracts' --if-present run test",
    "test:contracts": "pnpm --filter @ethglobal/contracts run test",
    "dupcheck": "jscpd apps packages services scripts",
    "format": "prettier --write . && forge fmt --root packages/contracts",
    "check-tools": "bash scripts/check-tools.sh"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
