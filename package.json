{
  "name": "ethglobal-mumbai",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm monorepo: Next.js web app, Hono API, Foundry contracts, sponsor-SDK adapters, design tokens.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:chain": "bash scripts/dev-chain.sh",
    "demo": "pnpm --filter @ethglobal/scripts exec tsx demo.ts",
    "demo:seed": "pnpm --filter @ethglobal/scripts exec tsx demo-seed.ts",
    "build": "pnpm -r run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --filter '!@ethglobal/contracts' --if-present run test",
    "test:ci": "pnpm -r --filter '!@ethglobal/contracts' --if-present run test -t '^(?!.*_RTFINDING$)'",
    "test:contracts": "pnpm --filter @ethglobal/contracts run test",
    "test:contracts:ci": "pnpm --filter @ethglobal/contracts exec forge test --no-match-test RTFINDING",
    "e2e": "bash scripts/e2e-local.sh",
    "e2e:local": "bash scripts/e2e-local.sh",
    "e2e:web": "bash scripts/e2e-local.sh --web",
    "print:cards": "pnpm --filter @ethglobal/scripts exec tsx print-cards.ts",
    "schema:gen": "pnpm --filter @ethglobal/scripts exec tsx gen-arkiv-schema.ts",
    "schema:check": "pnpm --filter @ethglobal/scripts exec tsx gen-arkiv-schema.ts --check",
    "redteam": "bash security/redteam/run-wave.sh",
    "audit": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:ci && pnpm test:contracts:ci && pnpm dupcheck && pnpm schema:check && pnpm --filter @ethglobal/contracts run abi:check && pnpm --filter @ethglobal/api run openapi:check && pnpm e2e && bash security/redteam/run-wave.sh all",
    "dupcheck": "jscpd apps packages services scripts",
    "format": "prettier --write . && forge fmt --root packages/contracts",
    "check-tools": "bash scripts/check-tools.sh"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
