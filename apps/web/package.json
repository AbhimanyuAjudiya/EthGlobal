{
  "name": "@ethglobal/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app: the Recharge consumer PWA (/, /verify, /plan, /install, /pay, /agent, /gift, /card, /receipts), the sponsor console (/sponsor) and the print route; /ui/* is tooling.",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-require-module next dev",
    "build": "NODE_OPTIONS=--experimental-require-module next build",
    "start": "NODE_OPTIONS=--experimental-require-module next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@ethglobal/contracts": "workspace:*",
