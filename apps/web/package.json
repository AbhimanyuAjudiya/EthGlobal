    "@ethglobal/eip3009": "workspace:*",
    "@ethglobal/protocol": "workspace:*",
    "@ethglobal/ui": "workspace:*",
    "@worldcoin/idkit-core": "catalog:",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/turbopack": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
