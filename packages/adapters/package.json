{
  "name": "@ethglobal/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Ports (Ledger, Personhood, PaymentRail, Reseller, ConsensusLog, BlobStore, Treasury, Inference, NameResolver), deterministic local mocks, live adapters (./live) and test helpers (./testing).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ethglobal/crypto": "workspace:*",
    "@ethglobal/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  }
}
