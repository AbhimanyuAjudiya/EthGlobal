        "bundleMb",
        "pricePerClaimUsd6",
        "maxClaims",
        "claimsPerHour",
        "validityDays",
        "wholesaleUsd6PerGb",
        "idResaleUsd6",
        "planId",
        "network",
        "contract",
        "createdAt",
        "expiresAt"
