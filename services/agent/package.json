{
  "name": "@ethglobal/agent",
  "version": "0.1.0",
  "private": true,
  "description": "The Recharge top-up agent: reads the entitlement, applies the code-enforced TopUpPolicy, buys 100 MB over x402 and writes an HCS receipt carrying its HCS-14 UAID.",
  "type": "module",
  "bin": {
    "recharge-agent": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ethglobal/adapters": "workspace:*",
    "@ethglobal/crypto": "workspace:*",
    "@ethglobal/eip3009": "workspace:*",
    "@ethglobal/octroi": "workspace:*",
    "@ethglobal/protocol": "workspace:*",
    "@hashgraph/hedera-agent-kit": "catalog:",
    "@hiero-ledger/sdk": "catalog:",
    "@x402/hedera": "catalog:",
    "pino": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hashgraphonline/standards-sdk": "catalog:",
    "@hono/node-server": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "hono": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
